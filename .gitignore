# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
venv/
.venv/
env/
ENV/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.pgpass
credentials.json

# Local databases / dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
# NOTE: *.sql is deliberately NOT ignored. The base schema (_schema_pg.sql)
# and every file in _migrations/ are SOURCE, not dumps — a blanket *.sql rule
# ships a repo that cannot create a single table on a fresh install.

# Logs & runtime
*.log
logs/
tmp/
.cache/
# NOTE: bench/evidence/ is deliberately NOT ignored. Those .log files ARE the
# evidence — chatlogs, agent logs and gateway windows that every scored claim in
# bench/reports/ is checked against. A blanket *.log rule ships a bench directory
# with no proof in it, which is worse than shipping no bench directory at all.
!bench/evidence/**/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
