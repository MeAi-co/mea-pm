# mea_pm — environment template
# Copy to .env and fill in. NEVER commit the real .env.

# ── PostgreSQL (required) ───────────────────────────────────────────────────
# The plugin stores all memory in PG. JPM_PG_HOST is the only required var.
JPM_PG_HOST=127.0.0.1
JPM_PG_PORT=5432
JPM_PG_DB=jpm
JPM_PG_USER=postgres
JPM_PG_PASSWORD=

# ── Embeddings (optional) ───────────────────────────────────────────────────
# Point at any OpenAI-compatible embeddings endpoint. Without it the engine
# falls back to lexical (FTS) search only.
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
